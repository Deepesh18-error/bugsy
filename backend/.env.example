REDIS_URL=redis://localhost:6379/0
CODEMAFIA_ENV=development
CODEMAFIA_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CODEMAFIA_SECURE_COOKIE=false
CODEMAFIA_COOKIE_SAMESITE=lax
CODEMAFIA_ROOM_TTL_SECONDS=3600
CODEMAFIA_CREDENTIAL_TTL_SECONDS=3600
CODEMAFIA_JOIN_WINDOW_SECONDS=60
CODEMAFIA_MAX_JOIN_ATTEMPTS=30
CODEMAFIA_CATEGORY_VOTE_SECONDS=30
CODEMAFIA_ROLE_REVEAL_SECONDS=8
CODEMAFIA_CODING_ROUND_SECONDS=180
CODEMAFIA_MEETING_DISCUSSION_SECONDS=30
CODEMAFIA_PLAYER_VOTE_SECONDS=30
CODEMAFIA_MEETING_COOLDOWN_SECONDS=60
CODEMAFIA_AUTO_TEST_DEBOUNCE_SECONDS=1.0
CODEMAFIA_EDITOR_SERVICE_KEY=replace-with-a-long-random-shared-secret
CODEMAFIA_EDITOR_WS_URL=ws://127.0.0.1:1234/api/rooms/editor/ws
# Leave empty until the isolated runner is configured; when enabled, use the same 32+ random bytes in both services.
CODEMAFIA_RUNNER_RESULT_HMAC_KEY=
# The editor service calls FastAPI with CODEMAFIA_EDITOR_SERVICE_KEY. It has no direct Redis access.
